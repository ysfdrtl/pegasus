# Pegasus yüzey tarama kütüphanesi (bkz. zikzak_tarama.pscan)
name = Tek yönlü tarama
description = Her çizgiyi aynı yönde boyar; çizgi sonunda kalkıp bir sonraki çizginin başına döner.
param offset = 5 | 0 | 200 | mm | Kenardan boşluk
param spacing = 10 | 0.5 | 200 | mm | Çizgi aralığı
param standoff = 50 | 0 | 500 | mm | Yüzeyden uzaklık
param angle = 0 | -180 | 180 | ° | Tarama açısı
param lift = 20 | 0 | 200 | mm | Kalkma yüksekliği
param crease = 60 | 0 | 180 | ° | Kırılma açısı (bu açıdan keskin kenarlar yüzeyi böler)
param tilt = 30 | 0 | 80 | ° | En fazla eğim (tabanca gerekirse normalden bu kadar sapar, eksen yine hedef noktaya bakar)
x = 0
y = 0
z = 0
work_angle = 0
travel_angle = 0
pattern = oneway
link = lift
orient = surface
