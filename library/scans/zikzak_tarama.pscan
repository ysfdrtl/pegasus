# Pegasus yüzey tarama kütüphanesi
# Zorunlu parametreler: offset (kenardan), spacing (çizgi aralığı), standoff (yüzeyden uzaklık), angle (tarama açısı)
# İsteğe bağlı: lift (geçişlerde kalkma yüksekliği), crease (yüzeyi bölen kırılma açısı, varsayılan 60), tilt (tabancanın normalden en fazla sapması)
# pattern = zigzag | oneway | crosshatch     link = surface | lift     orient = surface | fixed
# Formüller her tarama çizgisine eklenir: x = yan, y = çizgi boyunca, z = normal yönünde ek uzaklık
# Değişkenler: s, u, L (çizgi boyunca), t, v, k (çizgi no), n (çizgi sayısı)
name = Zikzak tarama
description = Yüzeyi paralel çizgilerle gidip gelerek tarar (sprey boya için standart desen).
param offset = 5 | 0 | 200 | mm | Kenardan boşluk
param spacing = 10 | 0.5 | 200 | mm | Çizgi aralığı
param standoff = 50 | 0 | 500 | mm | Yüzeyden uzaklık
param angle = 0 | -180 | 180 | ° | Tarama açısı
param lift = 20 | 0 | 200 | mm | Kalkma yüksekliği
param crease = 60 | 0 | 180 | ° | Kırılma açısı (bu açıdan keskin kenarlar yüzeyi böler)
param tilt = 30 | 0 | 80 | ° | En fazla eğim (tabanca gerekirse normalden bu kadar sapar, eksen yine hedef noktaya bakar)
x = 0
y = 0
z = 0
work_angle = 0
travel_angle = 0
pattern = zigzag
link = surface
orient = surface
